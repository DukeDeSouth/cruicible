# Gemini API key from https://aistudio.google.com/
GOOGLE_API_KEY=

# Phoenix Cloud from https://app.phoenix.arize.com/
# Replace YOUR_WORKSPACE with your Phoenix workspace name
PHOENIX_API_KEY=
PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com/s/YOUR_WORKSPACE

# Phoenix MCP is auto-configured from the above keys (stdio via npx)
# No separate PHOENIX_MCP_URL needed
